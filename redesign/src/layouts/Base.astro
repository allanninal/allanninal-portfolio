---
import '~/styles/global.css';
import SiteHeader from '~/components/SiteHeader.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import AnalyticsHead from '~/components/AnalyticsHead.astro';
import { maker, products } from '~/data/maker';

type Props = {
  title?: string;
  description?: string;
  ogTitle?: string;
};

const {
  title = `${maker.name} — ${maker.title}`,
  description = `${maker.name} — ${maker.title}. ${maker.tagline} ${products.length} live products, plus a free, MIT-licensed website template released every day.`,
  ogTitle,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const BASE = import.meta.env.BASE_URL;
const trimmedBase = BASE.endsWith('/') ? BASE.slice(0, -1) : BASE;
const ogImageUrl = new URL(`${trimmedBase}/og-image.png`, Astro.site).toString();
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site).toString();

// schema.org Person — AI and Software Engineer with products as makesOffer
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: maker.name,
  jobTitle: maker.title,
  url: siteUrl,
  description: maker.tagline,
  image: ogImageUrl,
  sameAs: [
    maker.socials.github,
    maker.socials.linkedin,
    maker.socials.facebook,
    maker.socials.devto,
  ],
  knowsAbout: ['Artificial Intelligence', 'Machine Learning', 'Data Engineering', 'Data Analytics', 'AWS', 'Python', 'TypeScript', 'Fullstack Development'],
  makesOffer: products.map(p => ({
    '@type': 'Offer',
    name: p.name,
    description: p.description,
    url: p.url,
    itemOffered: {
      '@type': 'SoftwareApplication',
      name: p.name,
      description: p.description,
      applicationCategory: 'WebApplication',
      operatingSystem: 'Web',
    },
  })),
};
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <AnalyticsHead />
    <meta name="theme-color" content="#05070E" />
    <meta name="color-scheme" content="dark" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={maker.name} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={ogTitle || title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${maker.name} — ${maker.title}`} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${maker.name} — ${maker.title}`} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle || title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href={`${trimmedBase}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${trimmedBase}/favicon.svg`} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- Set before first paint so the reveal styles apply without a flash, and
         so a reader without JavaScript never gets them at all. -->
    <script is:inline>document.documentElement.classList.add('has-js');</script>
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <SiteHeader />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <SiteFooter />

    <!-- Shared with every generated page on the site; see tools/nav/. -->
    <script is:inline defer src="/assets/site-nav.js"></script>

    <!-- Scroll reveals.
         Deliberately a scroll sweep rather than an IntersectionObserver. IO only
         calls back when an element's intersection *state* changes, so anything
         that goes from below the fold to above it between two frames — a fling
         on a phone, a jump to a #hash — never fires and stays at opacity 0
         forever. Blank sections are a far worse bug than a missed animation.
         This asks the question directly on each frame instead, and elements drop
         out of the list once revealed so the sweep drains to nothing. -->
    <script is:inline>
      (function () {
        var els = [].slice.call(document.querySelectorAll('.reveal'));
        if (!els.length) return;

        function show(el) { el.classList.add('is-in'); }

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          els.forEach(show);
          return;
        }

        els.forEach(function (el, i) {
          el.style.transitionDelay = Math.min(i % 6, 5) * 45 + 'ms';
        });

        var queued = false;
        function sweep() {
          queued = false;
          var limit = window.innerHeight * 0.94;
          els = els.filter(function (el) {
            if (el.getBoundingClientRect().top >= limit) return true;
            show(el);
            return false;
          });
          if (!els.length) {
            window.removeEventListener('scroll', onScroll);
            window.removeEventListener('resize', onScroll);
          }
        }
        function onScroll() {
          if (queued) return;
          queued = true;
          requestAnimationFrame(sweep);
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        sweep();
      })();
    </script>
  </body>
</html>
