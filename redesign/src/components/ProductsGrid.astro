---
import { products } from '~/data/maker';
---
<section
  id="products"
  class="section-gap"
  aria-labelledby="products-heading"
>
  <div class="container-x">
    <!-- Section header -->
    <div class="mb-10">
      <p class="label-eyebrow mb-2">Live products</p>
      <h2
        id="products-heading"
        class="text-3xl sm:text-4xl font-extrabold text-[var(--color-text)] mb-3"
        style="letter-spacing: -0.025em;"
      >
        Everything I've built &amp; shipped
      </h2>
      <p class="text-base text-muted max-w-2xl">
        The work I actively maintain: a privacy-first AI finance tool, a free template released every day, and open AWS architecture walkthroughs. Every one is live; click through to try it.
      </p>
    </div>

    <!-- Products grid -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5"
      role="list"
      aria-label="Live products"
    >
      {products.map((product) => (
        <article class="product-card" role="listitem">
          <!-- Top row: name + category -->
          <div class="flex items-start justify-between gap-3">
            <h3 class="text-xl font-bold text-[var(--color-text)]">{product.name}</h3>
            <span class="badge-live">
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-green-500" aria-hidden="true"></span>
              Live
            </span>
          </div>

          <!-- Category -->
          <p class="text-xs font-semibold uppercase tracking-widest text-accent">{product.category}</p>

          <!-- Description -->
          <p class="text-sm text-body leading-relaxed">{product.description}</p>

          <!-- Stack / tags -->
          {product.stack && (
            <div class="flex flex-wrap gap-1.5 mt-auto" role="list" aria-label={`${product.name} tags`}>
              {product.stack.map(tech => (
                <span class="tech-pill" role="listitem">{tech}</span>
              ))}
            </div>
          )}

          <!-- CTA -->
          <a
            href={product.url}
            class="btn-outline-accent self-start"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visit ${product.name} (opens in new tab)`}
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
            Visit product
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
