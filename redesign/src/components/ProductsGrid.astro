---
import { products } from '~/data/maker';
import SectionRail from '~/components/SectionRail.astro';

const [lead, ...rest] = products;
---
<section id="products" class="section-gap" aria-labelledby="products-heading">
  <div class="container-x">
    <SectionRail index="01" name="Live products" />

    <div class="mb-10 max-w-2xl reveal">
      <h2 id="products-heading" class="h-section">Everything I've built and shipped</h2>
      <p class="text-base text-muted text-pretty">
        The work I actively maintain and keep running. No case studies of things that no
        longer exist &mdash; every card below is a URL you can open right now.
      </p>
    </div>

    <!-- The flagship takes two columns; the rest sit alongside it. An even
         four-up grid would say all four matter equally, and they do not. -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" role="list" aria-label="Live products">
      <article class="product-card lg:col-span-2 reveal" role="listitem">
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="font-mono-x text-[0.6875rem] font-bold uppercase tracking-[0.18em] text-accent mb-1.5">{lead.category}</p>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-strong" style="letter-spacing:-0.03em;">{lead.name}</h3>
          </div>
          <span class="badge-live"><span class="pulse-dot" aria-hidden="true"></span>Live</span>
        </div>

        <p class="text-base text-body leading-relaxed max-w-xl">{lead.description}</p>

        {lead.stack && (
          <div class="flex flex-wrap gap-1.5 mt-auto pt-1" aria-label={`${lead.name} tags`}>
            {lead.stack.map((tech) => <span class="tech-pill">{tech}</span>)}
          </div>
        )}

        <a href={lead.url} class="btn-outline-accent self-start" target="_blank" rel="noopener noreferrer"
           aria-label={`Open ${lead.name} (opens in new tab)`}>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          OPEN
        </a>
      </article>

      {rest.map((product) => (
        <article class="product-card reveal" role="listitem">
          <div class="flex items-start justify-between gap-3">
            <h3 class="text-xl font-bold text-strong" style="letter-spacing:-0.02em;">{product.name}</h3>
            <span class="badge-live"><span class="pulse-dot" aria-hidden="true"></span>Live</span>
          </div>

          <p class="font-mono-x text-[0.6875rem] font-bold uppercase tracking-[0.18em] text-accent">{product.category}</p>
          <p class="text-sm text-body leading-relaxed">{product.description}</p>

          {product.stack && (
            <div class="flex flex-wrap gap-1.5 mt-auto pt-1" aria-label={`${product.name} tags`}>
              {product.stack.map((tech) => <span class="tech-pill">{tech}</span>)}
            </div>
          )}

          <a href={product.url} class="btn-outline-accent self-start" target="_blank" rel="noopener noreferrer"
             aria-label={`Open ${product.name} (opens in new tab)`}>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            OPEN
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
