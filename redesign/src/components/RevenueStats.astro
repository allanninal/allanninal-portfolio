---
import { stats, products } from '~/data/maker';

const liveCount = products.length;
---
<!-- Portfolio stats band -->
<section
  class="border-y border-[var(--color-border)]"
  style="background-color: var(--color-surface);"
  aria-labelledby="stats-heading"
>
  <div class="container-x py-12 sm:py-16">
    <p class="label-eyebrow text-center mb-8" id="stats-heading">
      A portfolio that ships · Real, live, and public
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">
      <!-- Live products -->
      <div class="flex flex-col items-center gap-2">
        <span class="stat-number text-4xl sm:text-5xl" aria-label={`${liveCount} live products`}>
          {liveCount}+
        </span>
        <span class="text-sm font-semibold text-muted uppercase tracking-widest">Live Products</span>
        <span class="text-xs text-subtle">Across AI, trading, Cebu &amp; SaaS</span>
      </div>

      <!-- Data analyses -->
      <div class="flex flex-col items-center gap-2">
        <span class="stat-number text-4xl sm:text-5xl" aria-label={`${stats.dataAnalysesLabel} data analyses`}>
          {stats.dataAnalysesLabel}
        </span>
        <span class="text-sm font-semibold text-muted uppercase tracking-widest">Data Analyses</span>
        <a href="#data" class="text-xs text-accent font-semibold hover:underline">Philippine open-data deep dives →</a>
      </div>

      <!-- AI/ML demos -->
      <div class="flex flex-col items-center gap-2">
        <span class="stat-number text-4xl sm:text-5xl" aria-label={`${stats.aiDemosLabel} AI and ML demos`}>
          {stats.aiDemosLabel}
        </span>
        <span class="text-sm font-semibold text-muted uppercase tracking-widest">AI / ML Demos</span>
        <span class="text-xs text-subtle">Open-source on GitHub</span>
      </div>
    </div>

    <p class="text-center text-xs text-subtle mt-6">
      Everything here is built and shipped end-to-end — design, data, AI, and the AWS infrastructure it runs on.
    </p>
  </div>
</section>
