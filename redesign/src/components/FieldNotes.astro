---
import { fieldNotes } from '~/data/maker';
---
<section id="field-notes" class="section-gap bg-surface-2" aria-labelledby="field-notes-heading">
  <div class="container-x">
    <div class="mb-10 max-w-2xl">
      <p class="label-eyebrow mb-2">Field notes</p>
      <h2
        id="field-notes-heading"
        class="text-3xl sm:text-4xl font-extrabold text-[var(--color-text)] mb-3"
        style="letter-spacing: -0.025em;"
      >
        Ecommerce and DNS fix guides
      </h2>
      <p class="text-lg text-body text-pretty">
        Researched guides that detect and repair real store problems with a small Python or Node.js script. Each platform has diagrams, the full script in both languages, and the tests that prove it works.
      </p>
    </div>

    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3" role="list">
      {fieldNotes.map((note) => (
        <li class="rounded-xl border border-[var(--color-border)] bg-paper p-5">
          <div class="flex items-baseline gap-2.5 mb-1.5">
            <h3 class="text-base font-bold text-[var(--color-text)]">
              <a href={note.href} class="hover:text-accent transition-colors">{note.name}</a>
            </h3>
          </div>
          <p class="text-sm text-muted">{note.detail}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
