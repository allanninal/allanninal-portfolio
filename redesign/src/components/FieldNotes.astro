---
import { fieldNotes } from '~/data/maker';
import { guideCounts, counts } from '~/data/counts';
import SectionRail from '~/components/SectionRail.astro';

/* Blurbs live in the data file; counts are read off disk. Joining them here
   keeps the one number that changes weekly out of anybody's hands. */
const byHref = new Map(guideCounts.map((g) => [g.href, g.count]));
const notes = fieldNotes.map((n) => ({ ...n, count: byHref.get(n.href) ?? 0 }));
---
<section id="field-notes" class="section-gap" aria-labelledby="field-notes-heading">
  <div class="container-x">
    <SectionRail index="03" name="Field notes" />

    <div class="mb-10 max-w-3xl reveal">
      <h2 id="field-notes-heading" class="h-section">
        <span class="stat-number text-accent">{counts.guides}</span> fixes, each with a script that runs
      </h2>
      <p class="text-base text-muted text-pretty">
        Researched guides that find one real problem with a small Python or Node.js script.
        Every one has diagrams, the full script in both languages, and the tests that prove
        it works. The platform scripts repair what they find and start in a dry run that
        writes nothing; the API scripts never write at all, because they hold a credential
        to a live payments or messaging account. All of them are free and open source.
      </p>
    </div>

    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3" role="list">
      {notes.map((note) => (
        <li class="reveal">
          <a href={note.href} class="panel panel--bracket flex flex-col gap-1.5 p-5 h-full group">
            <div class="flex items-baseline gap-3">
              <h3 class="text-base font-bold text-strong group-hover:text-accent transition-colors">{note.name}</h3>
              {note.count > 0 && (
                <span class="stat-number text-sm text-accent ml-auto">{String(note.count).padStart(2, '0')}</span>
              )}
            </div>
            <p class="text-sm text-muted leading-relaxed">{note.detail}</p>
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-8 text-base text-muted reveal">
      Every script lives in a public repo, one per platform, MIT licensed and with tests.
      <a href="https://github.com/allanninal" rel="noopener" class="font-semibold text-accent hover:underline">
        Browse all {notes.length} repos on GitHub &rarr;</a>
    </p>
  </div>
</section>
