---
import { fieldNotes } from '~/data/maker';
import fs from 'node:fs';
import path from 'node:path';

// Counts are read from disk at build time, never typed into the data file. Every stale
// figure on this site began as a number somebody wrote down once, and this one changes
// every time a note is added.
const siteRoot = path.resolve(process.cwd(), '..');

function countNotes(href: string): number {
  const dir = path.join(siteRoot, href.replace(/\//g, ''));
  try {
    return fs
      .readdirSync(dir, { withFileTypes: true })
      .filter((e) => e.isDirectory() && e.name !== 'assets').length;
  } catch {
    return 0;
  }
}

const notes = fieldNotes.map((n) => ({ ...n, count: countNotes(n.href) }));
const total = notes.reduce((sum, n) => sum + n.count, 0);
const platforms = notes.length;
---
<section id="field-notes" class="section-gap bg-surface-2" aria-labelledby="field-notes-heading">
  <div class="container-x">
    <div class="mb-10 max-w-2xl">
      <p class="label-eyebrow mb-2">Field notes</p>
      <h2
        id="field-notes-heading"
        class="text-3xl sm:text-4xl font-extrabold text-[var(--color-text)] mb-3"
        style="letter-spacing: -0.025em;"
      >
        {total} fixes, each with a script that runs
      </h2>
      <p class="text-lg text-body text-pretty">
        Researched guides that find and repair one real problem with a small Python or
        Node.js script. Every one has diagrams, the full script in both languages, and the
        tests that prove it works &mdash; and every script is free and open source, safe to
        try because it starts in a dry run that writes nothing.
      </p>
    </div>

    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3" role="list">
      {notes.map((note) => (
        <li class="rounded-xl border border-[var(--color-border)] bg-paper p-5">
          <div class="flex items-baseline gap-2.5 mb-1.5">
            <h3 class="text-base font-bold text-[var(--color-text)]">
              <a href={note.href} class="hover:text-accent transition-colors">{note.name}</a>
            </h3>
            {note.count > 0 && (
              <span class="text-xs font-semibold text-accent tabular-nums">{note.count}</span>
            )}
          </div>
          <p class="text-sm text-muted">{note.detail}</p>
        </li>
      ))}
    </ul>

    <p class="mt-8 text-base text-body">
      Every script lives in a public repo, one per platform, MIT licensed and with tests.
      <a
        href="https://github.com/allanninal"
        rel="noopener"
        class="font-semibold text-accent hover:underline"
        >Browse all {platforms} repos on GitHub &rarr;</a
      >
    </p>
  </div>
</section>
