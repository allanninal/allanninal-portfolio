---
import { maker, products } from '~/data/maker';
---
<section
  id="about"
  class="section-gap"
  aria-labelledby="about-heading"
>
  <div class="container-x">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
      <!-- Left: sticky sidebar -->
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-24">
          <p class="label-eyebrow mb-3">About</p>
          <h2
            id="about-heading"
            class="text-3xl sm:text-4xl font-extrabold text-[var(--color-text)] mb-4"
            style="letter-spacing: -0.025em;"
          >
            The story
          </h2>

          <!-- Avatar -->
          <div class="avatar mb-4 text-2xl" aria-hidden="true">AN</div>

          <!-- Quick stats sidebar -->
          <dl class="space-y-3 text-sm">
            <div class="flex items-center gap-2">
              <dt class="text-subtle font-medium w-24 flex-shrink-0">Location</dt>
              <dd class="text-body font-semibold">{maker.location}</dd>
            </div>
            <div class="flex items-center gap-2">
              <dt class="text-subtle font-medium w-24 flex-shrink-0">Focus</dt>
              <dd class="text-body font-semibold">AI/ML, Software Engineering</dd>
            </div>
            <div class="flex items-center gap-2">
              <dt class="text-subtle font-medium w-24 flex-shrink-0">Products</dt>
              <dd class="text-body font-semibold">{products.length} live</dd>
            </div>
            <div class="flex items-center gap-2">
              <dt class="text-subtle font-medium w-24 flex-shrink-0">Stack</dt>
              <dd class="text-body font-semibold">Python, JavaScript, AWS, Hugging Face</dd>
            </div>
          </dl>

          <!-- Available for -->
          <div class="mt-6 pt-6 border-t border-[var(--color-border)]">
            <p class="text-xs text-subtle uppercase tracking-widest font-semibold mb-2">Available for</p>
            <p class="text-sm text-body">{maker.availableFor}</p>
            <a
              href={maker.socials.linkedin}
              class="btn-outline-accent mt-3 text-xs"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Connect on LinkedIn (opens in new tab)"
            >
              Connect on LinkedIn
            </a>
          </div>
        </div>
      </div>

      <!-- Right: bio paragraphs -->
      <div class="lg:col-span-8">
        <div class="space-y-5 text-lg text-body leading-relaxed text-pretty">
          {maker.bio.map(paragraph => (
            <p>{paragraph}</p>
          ))}
        </div>

        <!-- Values / way of working -->
        <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-5">
          {[
            {
              title: 'Ship early, learn fast',
              body: 'A working prototype in two weeks beats a perfect plan in six months. I launch the moment there\'s something real to put in front of users.',
            },
            {
              title: 'Data first, AI on top',
              body: 'Good products start with understanding the data. I pair solid data engineering with modern AI/ML so features are genuinely useful, not just flashy.',
            },
            {
              title: 'Small products, real problems',
              body: 'I build focused tools that solve a genuine pain point — from privacy-first web apps to Cebu-specific services — rather than chasing scale for its own sake.',
            },
            {
              title: 'End-to-end ownership',
              body: 'Design, data, AI, and the AWS infrastructure it runs on — DNS, SSL, and servers included. I ship the whole thing and keep it running.',
            },
          ].map(item => (
            <div class="bg-surface border border-[var(--color-border)] rounded-xl p-5">
              <h3 class="text-base font-bold text-[var(--color-text)] mb-2">{item.title}</h3>
              <p class="text-sm text-body leading-relaxed">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
