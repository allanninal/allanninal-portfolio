---
import { maker, products } from '~/data/maker';
import { counts } from '~/data/counts';
import SectionRail from '~/components/SectionRail.astro';

const facts = [
  { k: 'location', v: maker.location },
  { k: 'focus', v: 'AI/ML, software engineering' },
  { k: 'products', v: `${products.length} live` },
  { k: 'guides', v: `${counts.guides} published` },
  { k: 'stack', v: 'Python, TypeScript, AWS, Hugging Face' },
];

const values = [
  {
    title: 'Ship early, learn fast',
    body: "A working prototype in two weeks beats a perfect plan in six months. I launch the moment there's something real to put in front of users.",
  },
  {
    title: 'Data first, AI on top',
    body: 'Good products start with understanding the data. I pair solid data engineering with modern AI/ML so features are genuinely useful, not just flashy.',
  },
  {
    title: 'Small products, real problems',
    body: 'I build focused tools that solve a genuine pain point — from privacy-first web apps to Cebu-specific services — rather than chasing scale for its own sake.',
  },
  {
    title: 'End-to-end ownership',
    body: 'Design, data, AI, and the AWS infrastructure it runs on — DNS, SSL, and servers included. I ship the whole thing and keep it running.',
  },
];
---
<section id="about" class="section-gap" style="background: var(--color-surface-2); border-block: 1px solid var(--color-border);" aria-labelledby="about-heading">
  <div class="container-x">
    <SectionRail index="06" name="About" />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
      <!-- Sidebar: the identification block -->
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-24 reveal">
          <h2 id="about-heading" class="h-section">The story</h2>

          <div class="flex items-center gap-4 mb-6">
            <div class="avatar" aria-hidden="true">AN</div>
            <div class="min-w-0">
              <p class="text-base font-bold text-strong truncate">{maker.name}</p>
              <p class="font-mono-x text-xs text-accent truncate">{maker.title}</p>
            </div>
          </div>

          <dl class="panel divide-y overflow-hidden">
            {facts.map((f) => (
              <div class="flex items-baseline gap-3 px-4 py-2.5 border-b last:border-b-0" style="border-color: var(--color-border);">
                <dt class="font-mono-x text-[0.6875rem] uppercase tracking-wider text-subtle w-20 flex-shrink-0">{f.k}</dt>
                <dd class="text-sm text-body font-semibold text-right ml-auto">{f.v}</dd>
              </div>
            ))}
          </dl>

          <div class="mt-6 pt-6 border-t" style="border-color: var(--color-border);">
            <p class="font-mono-x text-[0.6875rem] uppercase tracking-[0.2em] text-accent font-bold mb-2">
              {maker.openTo}
            </p>
            <p class="text-sm text-body mb-3">{maker.availableFor}</p>
            <a href={maker.socials.linkedin} class="btn-outline-accent" target="_blank" rel="noopener noreferrer"
               aria-label="Connect on LinkedIn (opens in new tab)">
              CONNECT ON LINKEDIN
            </a>
          </div>
        </div>
      </div>

      <!-- Bio -->
      <div class="lg:col-span-8">
        <div class="space-y-5 text-lg text-body leading-relaxed text-pretty reveal">
          {maker.bio.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-3">
          {values.map((item, i) => (
            <div class="panel panel--bracket p-5 reveal">
              <div class="flex items-baseline gap-2.5 mb-2">
                <span class="font-mono-x text-xs font-bold text-accent tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="text-base font-bold text-strong">{item.title}</h3>
              </div>
              <p class="text-sm text-muted leading-relaxed">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
