---
import { maker, products } from '~/data/maker';
---
<section class="section-gap" aria-labelledby="hero-heading">
  <div class="container-x">
    <div class="max-w-3xl">
      <!-- Avatar + name row -->
      <div class="flex items-center gap-4 mb-6">
        <div class="avatar" aria-hidden="true">AN</div>
        <div>
          <p class="text-sm font-semibold text-muted mb-0.5">{maker.location}</p>
          <p class="text-sm text-muted flex items-center gap-1.5">
            <!-- Green dot — live signal -->
            <span class="inline-block w-2 h-2 rounded-full bg-green-500 flex-shrink-0" aria-hidden="true"></span>
            Available for consulting
          </p>
        </div>
      </div>

      <!-- Headline -->
      <h1
        id="hero-heading"
        class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-[var(--color-text)] leading-tight tracking-tight mb-3 text-balance"
        style="letter-spacing: -0.03em;"
      >
        {maker.name}
      </h1>

      <!-- Title -->
      <p class="text-lg sm:text-xl font-bold text-accent mb-4">{maker.title}</p>

      <!-- Tagline -->
      <p class="text-xl sm:text-2xl font-semibold text-[var(--color-text-body)] mb-4 text-balance" style="letter-spacing: -0.01em;">
        {maker.tagline}
      </p>

      <!-- Sub-tagline -->
      <p class="text-base text-muted max-w-xl mb-8 text-pretty">
        Building and shipping in public — {products.length} live products, a free website template released every day, and 25 Philippine open-data analyses.
      </p>

      <!-- CTA row -->
      <div class="flex flex-wrap items-center gap-3 mb-8">
        <a href="#products" class="btn-primary">
          View my products
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="#contact" class="btn-ghost">
          Get in touch
        </a>
      </div>

      <!-- Social links -->
      <div class="flex items-center gap-2" role="list" aria-label="Social links">
        <!-- GitHub -->
        <a href={maker.socials.github} class="social-link" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile" role="listitem">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>
        <!-- LinkedIn -->
        <a href={maker.socials.linkedin} class="social-link" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile" role="listitem">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <!-- Facebook -->
        <a href={maker.socials.facebook} class="social-link" target="_blank" rel="noopener noreferrer" aria-label="Facebook profile" role="listitem">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        <!-- Dev.to -->
        <a href={maker.socials.devto} class="social-link" target="_blank" rel="noopener noreferrer" aria-label="Dev.to profile" role="listitem">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M7.42 10.05c-.18-.16-.46-.23-.84-.23H6v4.36h.58c.37 0 .65-.08.84-.23.19-.16.29-.42.29-.76V11.04c0-.35-.1-.6-.29-.76zM20.4 3H3.6C2.17 3 1 4.13 1 5.5v13C1 19.87 2.17 21 3.6 21h16.8c1.43 0 2.6-1.13 2.6-2.5v-13C23 4.13 21.83 3 20.4 3zM8.71 14.07c-.38.35-.97.52-1.71.52H5V9.41h1.98c.75 0 1.34.18 1.71.52.38.35.57.86.57 1.54v1.06c0 .68-.19 1.19-.57 1.54zm4.5-2.9H11v1.27h1.61v1.21H11v1.5h2.21v1.26H9.81V9.41h3.41v1.26h-.01zm5.35 3.16c-.27.63-.81.94-1.62.94-.56 0-1.01-.15-1.35-.47-.34-.31-.51-.75-.51-1.32v-.06h1.27c0 .27.05.47.16.62.11.15.27.22.49.22.24 0 .42-.09.54-.28.12-.18.18-.44.18-.78v-3.79h1.33v3.79c0 .53-.17 1-.49 1.13z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
