---
import { dataProjects, aiDemos } from '~/data/work';
import SectionRail from '~/components/SectionRail.astro';
---
<section id="data" class="section-gap" style="background: var(--color-surface-2); border-block: 1px solid var(--color-border);" aria-labelledby="data-heading">
  <div class="container-x">
    <SectionRail index="04" name="Data &amp; AI" />

    <div class="mb-10 max-w-2xl reveal">
      <h2 id="data-heading" class="h-section">Data analyses and AI/ML demos</h2>
      <p class="text-base text-muted text-pretty">
        {dataProjects.length} Philippine open-data deep dives and {aiDemos.length} open-source AI/ML
        demo apps. The full write-ups are on <a href="/blog/" class="text-accent font-semibold hover:underline">the blog</a>.
      </p>
    </div>

    <h3 class="font-mono-x text-[0.6875rem] font-bold uppercase tracking-[0.2em] text-subtle mb-4">
      Data analyses <span class="text-accent">[{dataProjects.length}]</span>
    </h3>
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2 mb-12" role="list">
      {dataProjects.map((item) => (
        <li class="reveal">
          <a href={item.href} class="panel-flat group flex items-center gap-2.5 px-4 py-3 text-sm font-semibold text-body hover:text-accent h-full">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 text-subtle group-hover:text-accent transition-colors" aria-hidden="true">
              <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
            </svg>
            <span>{item.name}</span>
          </a>
        </li>
      ))}
    </ul>

    <h3 class="font-mono-x text-[0.6875rem] font-bold uppercase tracking-[0.2em] text-subtle mb-4">
      AI / ML demos &middot; open source <span class="text-accent">[{aiDemos.length}]</span>
    </h3>
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2" role="list">
      {aiDemos.map((item) => (
        <li class="reveal">
          <a href={item.href} target="_blank" rel="noopener noreferrer"
             class="panel-flat group flex items-center gap-2.5 px-4 py-3 text-sm font-semibold text-body hover:text-accent h-full">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="flex-shrink-0 text-subtle group-hover:text-accent transition-colors" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
            <span>{item.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
