---
/* The spine of the page: an index, a rule that fades, a name in the machine
   voice. Repeated verbatim at the top of every section so the page scans as
   one continuous readout rather than a stack of unrelated blocks. */
type Props = { index: string; name: string };
const { index, name } = Astro.props;
---
<div class="rail">
  <span class="rail__index">&#167; {index}</span>
  <span class="rail__line" aria-hidden="true"></span>
  <span class="rail__name">{name}</span>
</div>
