---
import { currentProject, maker } from '~/data/maker';
---
<section
  id="building"
  class="section-gap bg-surface-2"
  aria-labelledby="building-heading"
>
  <div class="container-x">
    <div class="max-w-3xl mx-auto">
      <!-- Label -->
      <p class="label-eyebrow mb-3">What I'm building now</p>

      <!-- Heading -->
      <h2
        id="building-heading"
        class="text-3xl sm:text-4xl font-extrabold text-[var(--color-text)] mb-5"
        style="letter-spacing: -0.025em;"
      >
        {currentProject.name}
        <span
          class="inline-flex items-center gap-1.5 align-middle text-sm font-semibold px-3 py-1 rounded-full ml-3"
          style="vertical-align: middle; background-color: #DBEAFE; color: #1E3A8A;"
        >
          <span class="inline-block w-1.5 h-1.5 rounded-full flex-shrink-0" style="background-color: #1E3A8A;" aria-hidden="true"></span>
          {currentProject.status}
        </span>
      </h2>

      <!-- Description -->
      <p class="text-lg text-body leading-relaxed mb-6 text-pretty">
        {currentProject.description}
      </p>

      <!-- Stack -->
      <div class="flex flex-wrap items-center gap-4 mb-8">
        <div class="flex flex-wrap gap-1.5" role="list" aria-label="Tech stack">
          {currentProject.stack.map(tech => (
            <span class="tech-pill" role="listitem">{tech}</span>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="flex flex-wrap gap-3">
        <a
          href={currentProject.url}
          class="btn-primary"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Explore ${currentProject.name} (opens in new tab)`}
        >
          Explore the templates
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
        <a
          href={maker.socials.github}
          class="btn-ghost"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="See more work on GitHub (opens in new tab)"
        >
          See more on GitHub
        </a>
      </div>

      <!-- Build-in-public note -->
      <p class="text-sm text-subtle mt-6 italic">
        One template, every day, all free and MIT-licensed — built in public. The same design system powers this very portfolio.
      </p>
    </div>
  </div>
</section>
