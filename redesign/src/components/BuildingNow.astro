---
import { currentProject, maker } from '~/data/maker';
import { counts } from '~/data/counts';
import SectionRail from '~/components/SectionRail.astro';
---
<section id="building" class="section-gap" style="background: var(--color-surface-2); border-block: 1px solid var(--color-border);" aria-labelledby="building-heading">
  <div class="container-x">
    <SectionRail index="02" name="Shipping now" />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-7 reveal">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="badge-live"><span class="pulse-dot" aria-hidden="true"></span>{currentProject.status}</span>
          <span class="font-mono-x text-xs text-subtle tracking-wider">one per day, no skipped days</span>
        </div>

        <h2 id="building-heading" class="h-section">{currentProject.name}</h2>

        <p class="text-lg text-body leading-relaxed mb-6 text-pretty max-w-2xl">
          {currentProject.description}
        </p>

        <div class="flex flex-wrap gap-1.5 mb-8" aria-label="Tech stack">
          {currentProject.stack.map((tech) => <span class="tech-pill">{tech}</span>)}
        </div>

        <div class="flex flex-wrap gap-3">
          <a href={currentProject.url} class="btn-primary" target="_blank" rel="noopener noreferrer"
             aria-label={`Browse ${currentProject.name} (opens in new tab)`}>
            Browse all {counts.templates} templates
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href={maker.socials.github} class="btn-ghost" target="_blank" rel="noopener noreferrer"
             aria-label="See more work on GitHub (opens in new tab)">
            See the source on GitHub
          </a>
        </div>
      </div>

      <!-- A counter, sized like the thing it counts. -->
      <div class="lg:col-span-5 reveal">
        <div class="panel panel--bracket p-7 sm:p-9 text-center">
          <p class="font-mono-x text-[0.6875rem] font-bold uppercase tracking-[0.2em] text-subtle mb-3">
            templates published
          </p>
          <p class="stat-number text-6xl sm:text-7xl text-accent" style="text-shadow: 0 0 40px rgba(34,211,238,.35);">
            {counts.templates}
          </p>
          <div class="hairline my-6" aria-hidden="true"></div>
          <p class="text-sm text-muted text-pretty">
            Free, MIT licensed, mobile-first and static. Fork any one of them, ship it for a
            client, sell it &mdash; no attribution required, no strings.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
