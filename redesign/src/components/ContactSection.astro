---
import { maker, openings } from '~/data/maker';
import SectionRail from '~/components/SectionRail.astro';

const links = [
  { href: maker.socials.linkedin, label: 'LinkedIn', note: 'fastest reply', icon: 'linkedin' },
  { href: maker.socials.github, label: 'GitHub', note: 'code & issues', icon: 'github' },
  { href: maker.socials.devto, label: 'Dev.to', note: 'writing', icon: 'devto' },
  { href: maker.socials.facebook, label: 'Facebook', note: 'personal', icon: 'facebook' },
];

