  facebook: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z',
};
---
<section id="contact" class="section-gap" aria-labelledby="contact-heading">
  <div class="container-x">
    <SectionRail index="07" name="Contact" />

    <div class="panel panel--bracket overflow-hidden reveal">
      <div class="px-6 sm:px-10 py-10 sm:py-14 max-w-3xl mx-auto text-center">
        <span class="badge-live mb-5"><span class="pulse-dot" aria-hidden="true"></span>{maker.openTo}</span>

        <h2 id="contact-heading" class="h-section text-3xl sm:text-4xl lg:text-5xl">
          Let's build something together
        </h2>

        <p class="text-base sm:text-lg text-body mb-8 text-pretty">
          I'm not looking for a job in the usual sense. I'm looking for something to build
          and people to build it with &mdash; at a startup early enough that the product is
          still being decided, or on a problem that has been stuck for a while.
        </p>

        <ul class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-8 text-left" role="list">
          {openings.map((o) => (
            <li class="panel panel--bracket p-5 h-full">
              <h3 class="font-mono-x text-[0.6875rem] font-bold uppercase tracking-[0.16em] text-accent mb-2">
                {o.role}
              </h3>
              <p class="text-sm text-muted leading-relaxed">{o.detail}</p>
            </li>
          ))}
        </ul>

        <p class="text-sm text-muted mb-8 text-pretty">
          Tell me what you're working on and what's in your way. LinkedIn is the fastest way to reach me.
        </p>

        <a href={maker.socials.linkedin} class="btn-primary mb-9" target="_blank" rel="noopener noreferrer"
           aria-label="Connect on LinkedIn (opens in new tab)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={paths.linkedin}/></svg>
          Connect on LinkedIn
        </a>

        <div class="hairline mb-7" aria-hidden="true"></div>

        <ul class="grid grid-cols-2 sm:grid-cols-4 gap-2.5" role="list">
          {links.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener noreferrer"
                 class="panel-flat group flex flex-col items-center gap-1.5 px-3 py-4 h-full">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" class="text-muted group-hover:text-accent transition-colors" aria-hidden="true"><path d={paths[l.icon as keyof typeof paths]}/></svg>
                <span class="text-sm font-semibold text-body group-hover:text-accent transition-colors">{l.label}</span>
                <span class="font-mono-x text-[0.625rem] text-subtle tracking-wide">{l.note}</span>
              </a>
            </li>
          ))}
        </ul>

        <p class="text-xs text-subtle mt-7">
          If my open-source work or writing has helped you, you can
          <a href={maker.socials.kofi} class="text-accent hover:underline" target="_blank" rel="noopener noreferrer">buy me a coffee on Ko-fi</a>.
          No obligation &mdash; I build in public regardless.
        </p>
      </div>
    </div>
  </div>
</section>
