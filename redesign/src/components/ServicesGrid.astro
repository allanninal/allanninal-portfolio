---
import { services } from '~/data/maker';
---
<section id="services" class="section-gap bg-surface-2" aria-labelledby="services-heading">
  <div class="container-x">
    <!-- Section header -->
    <div class="mb-10 max-w-2xl">
      <p class="label-eyebrow mb-2">Services · scope {services.length}</p>
      <h2
        id="services-heading"
        class="text-3xl sm:text-4xl font-extrabold text-[var(--color-text)] mb-3"
        style="letter-spacing: -0.025em;"
      >
        What I can help you build
      </h2>
      <p class="text-lg text-body text-pretty">
        Automation engineered on AWS — not no-code, not glue scripts. Load-bearing infrastructure, apps, and data products, owned end to end.
      </p>
    </div>

    <!-- Services grid. The 01/02/03 markers are an index into a fixed scope list,
         not a sequence — they exist so a reader can refer to one by number. -->
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3" role="list">
      {services.map((service, i) => (
        <li class="rounded-xl border border-[var(--color-border)] bg-paper p-5">
          <div class="flex items-baseline gap-2.5 mb-1.5">
            <span class="text-xs font-semibold text-accent tabular-nums">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="text-base font-bold text-[var(--color-text)]">{service.name}</h3>
          </div>
          <p class="text-sm text-muted">{service.detail}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
