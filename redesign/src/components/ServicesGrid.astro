---
import { services } from '~/data/maker';
import SectionRail from '~/components/SectionRail.astro';
---
<section id="services" class="section-gap" aria-labelledby="services-heading">
  <div class="container-x">
    <SectionRail index="05" name="Where I can help" />

    <div class="mb-10 max-w-2xl reveal">
      <h2 id="services-heading" class="h-section">What we could build together</h2>
      <p class="text-base text-muted text-pretty">
        Engineered on AWS &mdash; not no-code, not glue scripts. Load-bearing infrastructure, apps
        and data products, owned end to end. Bring a problem in any of these and I'm interested.
      </p>
    </div>

    <!-- The 01/02/03 markers index a fixed list, not a sequence: they exist so
         a reader can point at one by number. -->
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3" role="list">
      {services.map((service, i) => (
        <li class="panel p-5 reveal">
          <div class="flex items-baseline gap-2.5 mb-1.5">
            <span class="font-mono-x text-xs font-bold text-accent tabular-nums">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="text-base font-bold text-strong">{service.name}</h3>
          </div>
          <p class="font-mono-x text-xs text-muted">{service.detail}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
