---
import { maker } from '~/data/maker';
const BASE = import.meta.env.BASE_URL;
---
<header class="sticky top-0 z-50 bg-paper border-b border-[var(--color-border)] backdrop-blur-sm">
  <div class="container-x">
    <nav class="flex items-center justify-between h-14" aria-label="Main navigation">
      <!-- Logo / name -->
      <a
        href={BASE}
        class="font-bold text-base text-[var(--color-text)] hover:text-accent transition-colors"
        aria-label={`${maker.name} — home`}
      >
        {maker.handle}
      </a>

      <!-- Desktop nav -->
      <ul class="hidden sm:flex items-center gap-6 text-sm font-semibold text-[var(--color-text-muted)]" role="list">
        <li><a href="#products" class="hover:text-accent transition-colors">Products</a></li>
        <li><a href="#data" class="hover:text-accent transition-colors">Data &amp; AI</a></li>
        <li><a href="/blog/" class="hover:text-accent transition-colors">Blog</a></li>
        <li><a href="#about" class="hover:text-accent transition-colors">About</a></li>
        <li><a href="#contact" class="hover:text-accent transition-colors">Contact</a></li>
      </ul>

      <!-- CTA -->
      <a
        href="#contact"
        class="btn-primary text-sm py-2 px-4"
        style="min-height: 36px; padding: 0.4375rem 1rem;"
      >
        Get in touch
      </a>
    </nav>
  </div>
</header>

<style>
  .bg-paper { background-color: var(--color-bg); }
</style>
