---
/**
 * The site header.
 *
 * This is the same bar, with the same classes and the same link set, that
 * `tools/nav/header.py` injects into every generated page on the site. The two
 * are kept in step deliberately: the header is the one element a visitor sees
 * on all ~1,400 pages, so it must not shift shape when they cross from the
 * built homepage into a generated section.
 *
 * Note counts are read off disk at build time — the same rule the Field Notes
 * section follows. A count typed into a data file is a count that goes stale.
 */
import fs from 'node:fs';
import path from 'node:path';

const siteRoot = path.resolve(process.cwd(), '..');

function noteCount(href: string): number {
  try {
    return fs
      .readdirSync(path.join(siteRoot, href.replace(/\//g, '')), { withFileTypes: true })
      .filter((e) => e.isDirectory() && e.name !== 'assets' && e.name !== 'downloads').length;
  } catch {
    return 0;
  }
}

const commerce = [
  { href: '/woocommerce/', name: 'WooCommerce' },
  { href: '/shopify/', name: 'Shopify' },
  { href: '/bigcommerce/', name: 'BigCommerce' },
  { href: '/medusa/', name: 'Medusa' },
  { href: '/shopware/', name: 'Shopware' },
  { href: '/saleor/', name: 'Saleor' },
  { href: '/prestashop/', name: 'PrestaShop' },
  { href: '/magento/', name: 'Magento' },
].map((n) => ({ ...n, count: noteCount(n.href) }));

const platform = [
  { href: '/aws/', name: 'AWS cost' },
  { href: '/cloudflare/', name: 'Cloudflare' },
  { href: '/ci/', name: 'GitHub Actions' },
  { href: '/email/', name: 'Email & SES' },
  { href: '/dns/', name: 'DNS & Domains' },
  { href: '/seo/', name: 'Technical SEO' },
].map((n) => ({ ...n, count: noteCount(n.href) }));

const work = [
  { href: '/#products', name: 'Products', tag: 'live' },
  { href: '/templates/', name: 'Templates', tag: '' },
  { href: '/spreadsheets/', name: 'Spreadsheets', tag: '' },
  { href: '/build/', name: 'Build on AWS', tag: '' },
  { href: '/#data', name: 'Data & AI', tag: '' },
];

const GITHUB = 'https://github.com/allanninal';
const LINKEDIN = 'https://www.linkedin.com/in/allanninal/';
---
<div class="anx-root">
  <a class="anx-skip" href="#main-content">Skip to content</a>
  <header class="anx-header">
    <div class="anx-bar">
      <a class="anx-brand" href="/" aria-label="Allan Niñal — home">
        <span class="anx-brand__mark">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9.5 7 5 12l4.5 5" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M14.5 7 19 12l-4.5 5" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" opacity=".55"/>
          </svg>
        </span>
        <span class="anx-brand__text">allanninal<span class="anx-brand__dim">.dev</span></span>
      </a>

      <nav class="anx-nav" aria-label="Primary">
        <a class="anx-link" href="/" aria-current="page">Home</a>

        <div class="anx-menu">
          <button class="anx-link" type="button" data-anx-menu aria-expanded="false" aria-controls="anx-work" aria-haspopup="true">
            Work
            <svg class="anx-link__chev" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="anx-panel" id="anx-work" hidden>
            <p class="anx-panel__title">What I build</p>
            {work.map((w) => (
              <a class="anx-item" href={w.href}>{w.name}{w.tag && <span class="anx-item__note">{w.tag}</span>}</a>
            ))}
          </div>
        </div>

        <div class="anx-menu">
          <button class="anx-link" type="button" data-anx-menu aria-expanded="false" aria-controls="anx-guides" aria-haspopup="true">
            Guides
            <svg class="anx-link__chev" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="anx-panel anx-panel--wide" id="anx-guides" hidden>
            <div class="anx-panel__group">
              <p class="anx-panel__title">Commerce platforms</p>
              {commerce.map((n) => (
                <a class="anx-item" href={n.href}>{n.name}{n.count > 0 && <span class="anx-item__note">{n.count}</span>}</a>
              ))}
            </div>
            <div class="anx-panel__group">
              <p class="anx-panel__title">Platform &amp; infra</p>
              {platform.map((n) => (
                <a class="anx-item" href={n.href}>{n.name}{n.count > 0 && <span class="anx-item__note">{n.count}</span>}</a>
              ))}
            </div>
          </div>
        </div>

        <a class="anx-link" href="/blog/">Blog</a>
        <a class="anx-link" href="/#about">About</a>
      </nav>

      <div class="anx-actions">
        <a class="anx-icon" href={GITHUB} rel="me noopener" target="_blank" aria-label="GitHub">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12.02c0 4.42 2.87 8.17 6.84 9.5.5.09.68-.22.68-.48 0-.24 0-.87-.01-1.7-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.56 9.56 0 0 1 12 6.84c.85 0 1.71.12 2.5.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.7-4.57 4.94.36.31.68.92.68 1.86 0 1.34-.01 2.42-.01 2.75 0 .27.18.58.69.48A10.02 10.02 0 0 0 22 12.02C22 6.48 17.52 2 12 2Z"/></svg>
        </a>
        <a class="anx-cta" href="#contact"><span class="anx-cta__dot" aria-hidden="true"></span>Collaborate</a>
        <button class="anx-burger" type="button" aria-expanded="false" aria-controls="anx-drawer" aria-label="Open menu">
          <span class="anx-burger__box" aria-hidden="true"><span></span><span></span><span></span></span>
        </button>
      </div>
    </div>

    <div class="anx-drawer" id="anx-drawer" hidden>
      <a class="anx-drawer__cta" href="#contact"><span class="anx-cta__dot" aria-hidden="true"></span>Open for collaboration</a>

      <div class="anx-acc"><a class="anx-acc__btn" href="/">Home</a></div>

      <div class="anx-acc">
        <button class="anx-acc__btn" type="button" data-anx-acc aria-expanded="false" aria-controls="anx-d-work">
          Work
          <svg class="anx-link__chev" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="anx-acc__panel" id="anx-d-work" hidden>
          {work.map((w) => (
            <a class="anx-item" href={w.href}>{w.name}{w.tag && <span class="anx-item__note">{w.tag}</span>}</a>
          ))}
        </div>
      </div>

      <div class="anx-acc">
        <button class="anx-acc__btn" type="button" data-anx-acc aria-expanded="false" aria-controls="anx-d-guides">
          Guides
          <svg class="anx-link__chev" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="anx-acc__panel" id="anx-d-guides" hidden>
          <p class="anx-panel__title">Commerce platforms</p>
          {commerce.map((n) => (
            <a class="anx-item" href={n.href}>{n.name}{n.count > 0 && <span class="anx-item__note">{n.count}</span>}</a>
          ))}
          <p class="anx-panel__title">Platform &amp; infra</p>
          {platform.map((n) => (
            <a class="anx-item" href={n.href}>{n.name}{n.count > 0 && <span class="anx-item__note">{n.count}</span>}</a>
          ))}
        </div>
      </div>

      <div class="anx-acc"><a class="anx-acc__btn" href="/blog/">Blog</a></div>
      <div class="anx-acc"><a class="anx-acc__btn" href="#about">About</a></div>

      <div class="anx-drawer__foot">
        <a href={GITHUB} rel="me noopener" target="_blank">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12.02c0 4.42 2.87 8.17 6.84 9.5.5.09.68-.22.68-.48 0-.24 0-.87-.01-1.7-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.56 9.56 0 0 1 12 6.84c.85 0 1.71.12 2.5.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.7-4.57 4.94.36.31.68.92.68 1.86 0 1.34-.01 2.42-.01 2.75 0 .27.18.58.69.48A10.02 10.02 0 0 0 22 12.02C22 6.48 17.52 2 12 2Z"/></svg>
          GitHub
        </a>
        <a href={LINKEDIN} rel="noopener" target="_blank">LinkedIn</a>
        <a href="https://ko-fi.com/allanninal" rel="noopener" target="_blank">Ko-fi</a>
      </div>
    </div>
  </header>
</div>
