---
import { maker } from '~/data/maker';
const year = new Date().getFullYear();
---
<footer class="border-t border-[var(--color-border)] py-8" aria-label="Site footer">
  <div class="container-x">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-muted">
      <p>
        &copy; {year}
        <a href={maker.socials.linkedin} class="font-semibold hover:text-accent transition-colors" target="_blank" rel="noopener noreferrer">
          {maker.name}
        </a>
        — built with
        <a href="https://astro.build" class="underline hover:text-accent transition-colors" target="_blank" rel="noopener noreferrer">Astro</a>
      </p>
      <div class="flex items-center gap-4">
        <a href="/blog/" class="hover:text-accent transition-colors" aria-label="Blog">
          Blog
        </a>
        <a href={maker.socials.github} class="hover:text-accent transition-colors" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          GitHub
        </a>
        <a href={maker.socials.linkedin} class="hover:text-accent transition-colors" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          LinkedIn
        </a>
        <a href={maker.socials.facebook} class="hover:text-accent transition-colors" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          Facebook
        </a>
        <a href={maker.socials.devto} class="hover:text-accent transition-colors" target="_blank" rel="noopener noreferrer" aria-label="Dev.to">
          Dev.to
        </a>
      </div>
    </div>
  </div>
</footer>
