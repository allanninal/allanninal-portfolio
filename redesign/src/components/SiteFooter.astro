---
import { maker } from '~/data/maker';
import { counts } from '~/data/counts';
const year = new Date().getFullYear();

const columns = [
  {
    title: 'Work',
    links: [
      { href: '/#products', label: 'Products' },
      { href: '/templates/', label: `Templates (${counts.templates})` },
      { href: '/spreadsheets/', label: 'Spreadsheets' },
      { href: '/build/', label: 'Build on AWS' },
      { href: '/#data', label: 'Data & AI' },
    ],
  },
  {
    title: 'Commerce guides',
    links: [
      { href: '/woocommerce/', label: 'WooCommerce' },
      { href: '/shopify/', label: 'Shopify' },
      { href: '/bigcommerce/', label: 'BigCommerce' },
      { href: '/medusa/', label: 'Medusa' },
      { href: '/shopware/', label: 'Shopware' },
      { href: '/saleor/', label: 'Saleor' },
      { href: '/prestashop/', label: 'PrestaShop' },
      { href: '/magento/', label: 'Magento' },
    ],
  },
  {
    title: 'Platform guides',
    links: [
      { href: '/aws/', label: 'AWS cost' },
      { href: '/cloudflare/', label: 'Cloudflare' },
      { href: '/ci/', label: 'GitHub Actions' },
      { href: '/email/', label: 'Email & SES' },
      { href: '/dns/', label: 'DNS & Domains' },
      { href: '/seo/', label: 'Technical SEO' },
    ],
  },
  {
    title: 'Elsewhere',
    links: [
      { href: '/blog/', label: 'Blog' },
      { href: maker.socials.github, label: 'GitHub' },
      { href: maker.socials.linkedin, label: 'LinkedIn' },
      { href: maker.socials.devto, label: 'Dev.to' },
      { href: maker.socials.kofi, label: 'Ko-fi' },
    ],
  },
];
---
<footer style="border-top: 1px solid var(--color-border); background: var(--color-surface-2);" aria-label="Site footer">
  <div class="container-x py-12 sm:py-16">
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-8 mb-12">
      <div class="col-span-2 lg:col-span-1">
        <p class="text-base font-bold text-strong mb-1">allanninal<span class="text-muted">.dev</span></p>
        <p class="font-mono-x text-xs text-subtle mb-4 leading-relaxed">{maker.location}</p>
        <span class="badge-live"><span class="pulse-dot" aria-hidden="true"></span>{maker.openTo}</span>
      </div>

      {columns.map((col) => (
        <nav aria-label={col.title}>
          <p class="font-mono-x text-[0.6875rem] font-bold uppercase tracking-[0.18em] text-accent mb-3">{col.title}</p>
          <ul class="space-y-2" role="list">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="text-sm text-muted hover:text-accent transition-colors">{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="hairline mb-6" aria-hidden="true"></div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 font-mono-x text-xs text-subtle">
      <p>&copy; {year} {maker.name}</p>
      <p>
        built with <a href="https://astro.build" class="text-muted hover:text-accent transition-colors" target="_blank" rel="noopener noreferrer">Astro</a>
        &middot; deployed on GitHub Pages
      </p>
    </div>
  </div>
</footer>
