---
import Base from '~/layouts/Base.astro';
---
<Base
  title="404 — Page Not Found"
  description="This page doesn't exist. Head back to the main site."
>
  <section class="section-gap flex items-center justify-center min-h-[62vh]">
    <div class="container-x">
      <div class="panel panel--bracket max-w-xl mx-auto p-8 sm:p-12 text-center">
        <p class="font-mono-x text-[0.6875rem] font-bold uppercase tracking-[0.22em] text-subtle mb-4">
          HTTP 404 &middot; not found
        </p>
        <p class="stat-number text-7xl sm:text-8xl text-accent mb-5" style="text-shadow: 0 0 44px rgba(34,211,238,.35);" aria-hidden="true">404</p>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-strong mb-3" style="letter-spacing:-0.03em;">
          This page isn't here
        </h1>
        <p class="text-base text-muted mb-8 text-pretty">
          The URL is wrong, or whatever used to live here has been retired. Everything that is
          still live is one click away.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a href="/" class="btn-primary">Go home</a>
          <a href="/templates/" class="btn-ghost">Browse templates</a>
        </div>
      </div>
    </div>
  </section>
</Base>
