---
import Base from '~/layouts/Base.astro';
const BASE = import.meta.env.BASE_URL;
---
<Base
  title="404 — Page Not Found"
  description="This page doesn't exist. Head back to the main site."
>
  <section class="section-gap flex flex-col items-center justify-center min-h-[60vh] text-center">
    <div class="container-x">
      <p class="stat-number text-8xl mb-4" style="color: var(--color-accent);" aria-hidden="true">404</p>
      <h1 class="text-3xl font-extrabold text-[var(--color-text)] mb-4" style="letter-spacing: -0.025em;">
        Page not found
      </h1>
      <p class="text-base text-muted mb-8 max-w-md mx-auto">
        Looks like this URL got sunsetted. Head back to the main page.
      </p>
      <a href={BASE} class="btn-primary">Go home</a>
    </div>
  </section>
</Base>
