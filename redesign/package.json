{
  "name": "@templates/indie-hacker-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:links": "linkinator dist --recurse --silent --skip 'http://localhost' --skip 'https://ko-fi.com' --skip 'https://www.linkedin.com' --skip 'https://github.com' --skip 'https://x.com' --skip 'https://buttondown.email' --skip 'https://buttondown.com' --skip 'https://twitter.com' --skip 'https://formcraft.app' --skip 'https://pingalert.io' --skip 'https://docuflow.dev' --skip 'https://vaultnote.app'",
    "test:lighthouse": "lhci autorun",
    "test:all": "npm run build && npm run test && npm run test:links && npm run test:lighthouse"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.2.1",
    "@astrojs/tailwind": "^5.1.2",
    "@fontsource-variable/plus-jakarta-sans": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "astro": "^4.16.18",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "linkinator": "^6.1.0",
    "typescript": "^5.7.0"
  }
}
