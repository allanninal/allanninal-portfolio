# Indie Hacker Portfolio — environment variables
#
# Copy to .env and fill in your values.
# None of these are required for a local build — they only affect
# the generated site URL and OG image canonical paths.

# The live domain where this site will be deployed.
# Used by Astro for sitemap generation and canonical URLs.
PUBLIC_SITE_URL=https://templates.allanninal.dev

# The base path for the site — must match the GitHub Pages sub-path.
# If you're deploying to a custom domain at root, set this to /
PUBLIC_BASE_PATH=/indie-hacker-portfolio/

# Buttondown newsletter slug (for the subscribe form embed).
# Replace with your own Buttondown username or leave as-is for demo.
PUBLIC_BUTTONDOWN_SLUG=allanninal
