    "Read the intake sheet": {
      "main": [
        [
          {
            "node": "Read one claim",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read one claim": {
      "main": [
        [
          {
            "node": "Validates the submission, fingerprints it, enqueues one cl",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validates the submission, fingerprints it, enqueues one cl": {
      "main": [
        [
          {
            "node": "Seen this trip?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Seen this trip?": {
      "main": [
        [
