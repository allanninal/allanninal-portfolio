{
  "name": "Chargeback responder (2026-06-30)",
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:watchRows",
      "version": 2,
      "parameters": {
        "__IMTCONN__": null
      },
      "mapper": {
        "mode": "select",
        "spreadsheetId": "/SPREADSHEET_ID",
        "sheetId": "Intake",
        "includesHeaders": true,
        "limit": 100
      },
      "filter": null,
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Watch the intake sheet"
        }
      }
    },
    {
      "id": 2,
      "module": "openai-gpt-3:CreateCompletion",
      "version": 1,
      "parameters": {
        "__IMTCONN__": null
      },
      "mapper": {
        "model": "gpt-4o-mini",
        "max_tokens": 400,
        "temperature": 0,
        "prompt": "Extract the fields the article names. Absent means null, never a default. Dates come back as strings in a stated format.\n\n{{1.`0`}}"
      },
      "filter": null,
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Read one item"
        }
      }
    },
    {
      "id": 3,
      "module": "google-sheets:addRow",
      "version": 2,
      "parameters": {
        "__IMTCONN__": null
      },
      "mapper": {
        "mode": "select",
        "spreadsheetId": "/SPREADSHEET_ID",
        "sheetId": "Deadlines",
        "includesHeaders": true,
        "valueInputOption": "USER_ENTERED",
        "values": {
          "0": "{{2.choices[].text}}"
        }
      },
      "filter": null,
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Continue: append the record"
        }
      }
    },
    {
      "id": 4,
      "module": "google-email:ActionSendEmail",
      "version": 2,
      "parameters": {
        "__IMTCONN__": null
      },
      "mapper": {
        "to": [
          "operations@example.com"
        ],
        "subject": "Chargeback responder: run complete",
        "html": "See the appended rows.",
        "attachments": []
      },
      "filter": null,
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0,
          "name": "Send the result"
        }
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "confidential": false,
      "dataloss": false,
      "dlq": false
    },
    "designer": {
      "orphans": []
    }
  }
}
