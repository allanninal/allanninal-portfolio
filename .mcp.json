{
  "mcpServers": {
    "n8n": {
      "command": "npx",
      "args": ["-y", "n8n-mcp"],
      "env": {
        "MCP_MODE": "stdio",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "LOG_LEVEL": "error"
      }
    },
    "make": {
      "command": "npx",
      "args": ["-y", "@makehq/mcp-server"],
      "env": {
        "MAKE_API_KEY": "${MAKE_API_KEY:-}",
        "MAKE_ZONE": "${MAKE_ZONE:-eu2.make.com}",
        "MAKE_TEAM": "${MAKE_TEAM:-}"
      }
    }
  }
}
